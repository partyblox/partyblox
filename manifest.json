{
  "manifest_version": 3,
  "name": "PartyBlox Native YouTube PiP",
  "version": "1.0.0",
  "description": "Ativa o Picture-in-Picture nativo do Chrome no vídeo do YouTube dentro do iframe do PartyBlox.",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*", "https://partyblox.onrender.com/*"],
  "content_scripts": [
    {
      "matches": ["https://partyblox.onrender.com/*"],
      "js": ["partyblox-top.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"],
      "js": ["youtube-frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
